{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "azerothmarket",
  "main": "./_worker.js",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
